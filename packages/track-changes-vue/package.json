{
  "name": "track-changes-vue",
  "version": "0.12.1",
  "description": "Vue 3 adapter for track-changes-core: a thin <TrackChangesEditor> built on @tiptap/vue-3.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carsonhung/track-changes.git",
    "directory": "packages/track-changes-vue"
  },
  "keywords": [
    "vue",
    "tiptap",
    "prosemirror",
    "track-changes",
    "suggesting",
    "editor"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "@tiptap/core": "^2.0.0",
    "@tiptap/starter-kit": "^2.0.0",
    "@tiptap/vue-3": "^2.0.0",
    "track-changes-core": ">=0.9.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@tiptap/core": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "@tiptap/vue-3": "^2.11.0",
    "track-changes-core": "*",
    "tsup": "^8.3.0",
    "typescript": "~5.9.3",
    "vue": "^3.5.29"
  }
}

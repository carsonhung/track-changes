{
  "name": "track-changes-vanilla",
  "version": "0.1.0",
  "description": "Framework-free adapter for track-changes-core: mount a track-changes Tiptap editor (toolbar + counter) on any DOM element.",
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carsonhung/track-changes.git",
    "directory": "packages/track-changes-vanilla"
  },
  "keywords": [
    "vanilla",
    "tiptap",
    "prosemirror",
    "track-changes",
    "suggesting",
    "editor"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "NOTICE",
    "COMMERCIAL-LICENSE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "@tiptap/core": "^2.0.0",
    "@tiptap/pm": "^2.0.0",
    "@tiptap/starter-kit": "^2.0.0",
    "track-changes-core": ">=0.9.0"
  },
  "devDependencies": {
    "@tiptap/core": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "happy-dom": "^20.10.2",
    "track-changes-core": "*",
    "tsup": "^8.3.0",
    "typescript": "~5.9.3",
    "vitest": "^2.1.0"
  },
  "author": "Dr. Carson Hung"
}
